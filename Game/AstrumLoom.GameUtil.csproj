<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!--
      GameUtil はバックエンドを全部知っている「起動層」。
      ゲーム側はこのプロジェクトだけを参照すれば、DxLib / Raylib のどちらでも動かせる。
    -->
    <ProjectReference Include="..\Core\AstrumLoom.csproj" />
    <ProjectReference Include="..\DXLib\AstrumLoom.DXLib.csproj" />
    <ProjectReference Include="..\RayLib\AstrumLoom.RayLib.csproj" />
    <ProjectReference Include="..\Extend\AstrumLoom.Extend.csproj" />
  </ItemGroup>

</Project>
