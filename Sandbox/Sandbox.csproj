<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BaseOutputPath>..\</BaseOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- GameUtil が Core / DXLib / RayLib / Extend をまとめて連れてくる。 -->
    <ProjectReference Include="..\Game\AstrumLoom.GameUtil.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      技術検証用: SkiaDemo だけがこれを使う。AstrumLoom.Core/RayLib 側は一切 SkiaSharp を
      知らない（LoadTextureFromMemory は生の byte[] しか受け取らない）ので、この依存は
      Sandbox から出ていかない。
    -->
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
  </ItemGroup>

  <ItemGroup>
    <!--
      デモシーンの素材。tools\make-sandbox-assets.ps1 で手続き生成できるので、
      消えても作り直せる。出力先（..\Debug\Assets）へそのままコピーする。
    -->
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
